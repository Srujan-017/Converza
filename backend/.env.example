# Copy this file to .env and fill in your values. Never commit .env.

# MongoDB Atlas connection string (required)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>

# Port for the API and Socket.IO server (optional, default 8000)
PORT=8000

# --- SFU (mediasoup) settings ---

# Off by default: meetings then use peer-to-peer, which works on any host.
# Turn on where the server can receive media on the port range below (EC2,
# your own machine). Render can't, so leave it off there.
# SFU_ENABLED=true

# Number of media workers; defaults to the number of CPU cores
# MEDIASOUP_NUM_WORKERS=1

# Local development: leave as 127.0.0.1
# Cloud server: set LISTEN_IP to 0.0.0.0 and ANNOUNCED_ADDRESS to the public IP
# MEDIASOUP_LISTEN_IP=127.0.0.1
# MEDIASOUP_ANNOUNCED_ADDRESS=

# UDP/TCP ports for media; open this range in the server firewall
# MEDIASOUP_MIN_PORT=40000
# MEDIASOUP_MAX_PORT=49999
